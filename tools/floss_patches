"""A script for manipulating the Floss upstream/local patches"""

import argparse
import base64
from datetime import datetime
import json
import logging
from pathlib import Path
import shutil
import string
import subprocess
import tempfile
import textwrap
import urllib.request


class GitHelper(object):
    """Git helper class that runs git commands on a specific path."""

    def __init__(self, path):
        self.path = path
        self.git_command = ["git", "-C", str(self.path)]

    def clone(self, repo_url, branch=None, depth=None):
        """Clones a remote repo to local.

        Args:
            repo_url: The remote repo URL str.
            branch: The target branch name. If None, clones all branches.
            depth: The history depth. If None, clones the full history.
        """
        cmd = ["git", "clone"]
        if branch is not None:
            cmd.append("--branch")
            cmd.append(branch)
        if depth is not None:
            cmd.append("--depth")
            cmd.append(str(depth))
        cmd.append(repo_url)
        cmd.append(str(self.path))
        subprocess.check_call(cmd)

    def add(self):
        """Adds all changes into index."""
        subprocess.check_call(self.git_command + ["add", "."])

    def diff(self, stat=None):
        """Returns the diff of the cached (staged) changes.

        Args:
            stat: The diff stat format.
        """
        cmd = ["diff", "--cached"]
        if stat is not None:
            cmd.append(f"--stat={stat}")
        return subprocess.check_output(self.git_command + cmd)


class OverlayHelper(object):
    """Helper for modifying the given chromiumos-overlay repo."""

    GIT_AM_HINT_PREFIX = "DEV_PATCHES=(  # git am hint: "
    REL_PATCHES_START_LINE = "REL_PATCHES=(\n"
    REL_PATCHES_END_LINE = ")  # REL_PATCHES end\n"

    def __init__(self, path):
        self.overlay_path = path
        self.floss_overlay_path = self.overlay_path / "net-wireless" / "floss"
        if not self.floss_overlay_path.is_dir():
            raise ValueError("Failed to anchor Floss overlay directory path")
        self.ebuild_path = self.floss_overlay_path / "floss-9999.ebuild"
        if not self.ebuild_path.is_file():
            raise ValueError("Failed to anchor Floss ebuild path")

    def floss_pull_upstream_patches(self):
        """Pulls all upstream patch files to local.

        All local patch files will be removed and the REL_PATCHES list in
        floss-9999.ebuild will be updated.
        """
        local_patches_path = self.floss_overlay_path / "files" / "patches"
        if local_patches_path.exists():
            if not local_patches_path.is_dir():
                raise ValueError(f"{local_patches_path} is not a dir")
            shutil.rmtree(str(local_patches_path))

        upstream_patches_path = (
            self.floss_overlay_path / "files" / "patches_upstream"
        )
        if upstream_patches_path.exists():
            if not upstream_patches_path.is_dir():
                raise ValueError(f"{upstream_patches_path} is not a dir")
            logging.debug(
                "Copying upstream patches from %s to %s",
                upstream_patches_path,
                local_patches_path,
            )
            shutil.copytree(str(upstream_patches_path), str(local_patches_path))

        with open(str(self.ebuild_path), "r") as filehandle:
            floss_ebuild_lines = filehandle.readlines()

        rel_patches_start_line = None
        rel_patches_end_line = None
        logging.debug("Current REL_PATCHES:")
        for i, line in enumerate(floss_ebuild_lines):
            if line == self.REL_PATCHES_END_LINE:
                rel_patches_end_line = i
                break
            if rel_patches_start_line is not None:
                logging.debug(" %s", line.strip())
            if line == self.REL_PATCHES_START_LINE:
                rel_patches_start_line = i + 1
        if rel_patches_start_line is None or rel_patches_end_line is None:
            raise RuntimeError("Failed to anchor REL_PATCHES list")

        logging.debug("New REL_PATCHES:")
        local_patch_lines = []
        if local_patches_path.exists():
            for patches in sorted(local_patches_path.iterdir()):
                local_patch_lines.append(
                    '\t"${FILESDIR}"/patches/' + patches.name + "\n"
                )
                logging.debug(" %s", local_patch_lines[-1].strip())
        logging.debug(
            "Update %s's REL_PATCHES with current local patches",
            self.ebuild_path,
        )
        with open(str(self.ebuild_path), "w") as filehandle:
            filehandle.writelines(floss_ebuild_lines[:rel_patches_start_line])
            filehandle.writelines(local_patch_lines)
            filehandle.writelines(floss_ebuild_lines[rel_patches_end_line:])

    def floss_update_git_am_hint(self, hint):
        """Updates the git am hint in floss-9999.ebuild.

        The hint indicates the "known good commit" that the upstream patches
        can be applied on without conflicts. There are 2 common timing to
        update it:
            * Some upstream conflicts are fixed
            * A new merge from upstream to local just landed (local and
              upstream tree should be exactly the same on the point of merge,
              if the merge passed CQ then it must be a good commit)

        Args:
            hint: The 40-letters SHA-1 hash.
        """
        if len(hint) != 40 or any(c not in string.hexdigits for c in hint):
            raise ValueError(
                "Invalid git am hint, expect a 40-digits commit hash"
            )

        with open(str(self.ebuild_path), "r") as filehandle:
            floss_build_lines = filehandle.readlines()
        for i in range(len(floss_build_lines)):
            if floss_build_lines[i].startswith(self.GIT_AM_HINT_PREFIX):
                logging.debug(
                    "Changing git am hint from %s to %s",
                    floss_build_lines[i][len(self.GIT_AM_HINT_PREFIX) : -1],
                    hint,
                )
                floss_build_lines[i] = f"{self.GIT_AM_HINT_PREFIX}{hint}\n"
                break
        else:
            raise RuntimeError("Git am hint not found in ebuild")
        logging.debug(
            "Update %s's `git am hint` with the specified hint",
            self.ebuild_path,
        )
        with open(str(self.ebuild_path), "w") as filehandle:
            filehandle.writelines(floss_build_lines)


def gerrit(api_name, method=None, data=None):
    """Sends requests to CrOS external Gerrit instance.

    Args:
        api_name: The Gerrit API name as part of Gerrit request URL.
        method: HTTP method e.g. 'GET', 'POST'.
        data: The HTTP body. It is always converted to JSON.

    Returns:
        The parsed JSON response if any; Otherwise None.
    """

    def get_git_cookies(path):
        """Returns the user's gitcookies matching the path."""
        cookies = {}
        with open(str(Path.home() / ".gitcookies"), "r") as filehandle:
            for line in filehandle:
                fields = line.strip().split("\t")
                if line.strip().startswith("#") or len(fields) != 7:
                    continue
                domain, xpath, key, value = (
                    fields[0],
                    fields[2],
                    fields[5],
                    fields[6],
                )
                if (
                    domain == "chromium-review.googlesource.com"
                    and path.startswith(xpath)
                ):
                    cookies[key] = value
        if not cookies:
            raise RuntimeError("Valid git cookie not found")
        return "; ".join(f"{k}={v}" for k, v in cookies.items())

    url = f"https://chromium-review.googlesource.com/a/{api_name}"
    headers = {"Cookie": get_git_cookies(f"/a/{api_name}")}
    if data is not None:
        data = json.dumps(data).encode("utf-8")
        headers["Content-Type"] = "application/json; charset=utf-8"
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    logging.debug("Calling Gerrit API: URL=%s, method=%s", url, method)
    with urllib.request.urlopen(req) as handle:
        response = handle.read()

    if not response:
        return None

    response = response.decode("utf-8")
    MAGIC_PREFIX = ")]}'"
    if not response.startswith(MAGIC_PREFIX):
        raise RuntimeError("Unexpected Gerrit API response format")
    response = response[len(MAGIC_PREFIX) :]
    return json.loads(response)


def create_overlay_cl_from_merge(merge_cl_number):
    """Creates an overlay CL from a given merge CL.

    Implementation of `floss_patches pull --from_merge`.
    """
    merge_cl_id = "aosp/platform/packages/modules/Bluetooth~".replace(
        "/", "%2F"
    ) + str(merge_cl_number)

    # The first hash in the merge list; Used for git am hint
    hash = gerrit(
        f"changes/{merge_cl_id}/revisions/current/mergelist", method="GET"
    )[0]["commit"]

    # Generate the overlay diff in a temporary directory.
    with tempfile.TemporaryDirectory() as temp_dir:
        temp_dir = Path(temp_dir)
        git_helper = GitHelper(temp_dir)
        logging.info("Cloning chromiumos-overlay...")
        # Cloning with depth=1 because the history is really heavy (~2GB).
        git_helper.clone(
            "https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay",
            branch="main",
            depth=1,
        )

        overlay_helper = OverlayHelper(temp_dir)
        overlay_helper.floss_pull_upstream_patches()
        overlay_helper.floss_update_git_am_hint(hash)

        git_helper.add()
        logging.debug(
            "Overlay diff stat:\n%s",
            # The default stat width (80) is usually not enough for displaying
            # the patch files.
            git_helper.diff(stat=200).decode("utf-8")[:-1],
        )
        diff = git_helper.diff()

    # Create the CL for updating patch files
    curr_time = datetime.utcnow().isoformat() + "Z"  # 'Z' indicates UTC+0
    overlay_cl_message = textwrap.dedent(
        f"""\
        floss: Pull upstream patches to local at {curr_time}

        BUG=None
        TEST=CQ

        Cq-Depend: chromium:{merge_cl_number}
        """
    )
    change_input = {
        "project": "chromiumos/overlays/chromiumos-overlay",
        "branch": "main",
        "subject": overlay_cl_message,
        "patch": {"patch": base64.b64encode(diff).decode("utf-8")},
    }
    logging.info("Creating overlay CL...")
    overlay_cl = gerrit("changes/", method="POST", data=change_input)

    logging.info(
        "Created overlay CL: https://crrev.com/c/%s; "
        "Setting Cq-Depend for the merge CL...",
        overlay_cl["_number"],
    )

    message = gerrit(
        f"changes/{merge_cl_id}/revisions/current/commit", method="GET"
    )["message"]
    message = message.splitlines(True)
    # Update Cq-Depend field with the overlay CL. First remove the old one.
    for i in range(len(message)):
        if message[i].startswith("Cq-Depend: "):
            message = message[:i] + message[i + 1 :]
            break
    for i in range(len(message)):
        if message[i].startswith("Change-Id: "):
            # Intentionally put Cq-Depend after Change-Id to follow the message
            # format generated by |overlay_cl_message|.
            message = (
                message[: i + 1]
                + [f'Cq-Depend: chromium:{overlay_cl["_number"]}\n']
                + message[i + 1 :]
            )
            break
    else:
        raise RuntimeError("Change-Id not found in the merge CL")
    gerrit(
        f"changes/{merge_cl_id}/message",
        method="PUT",
        data={"message": "".join(message)},
    )

    logging.info("Updated Cq-Depend of the merge CL; Voting CQ+1...")

    gerrit(
        f"changes/{merge_cl_id}/revisions/current/review",
        method="POST",
        data={"labels": {"Commit-Queue": 1}},
    )
    gerrit(
        f'changes/{overlay_cl["id"]}/revisions/current/review',
        method="POST",
        data={"labels": {"Commit-Queue": 1}},
    )
    logging.info("Set CQ dry run successfully")


def create_merge():
    """Creates an overlay CL and a Floss merge CL.

    Implementation of `floss_patches pull`.
    """
    logging.info("Creating merge...")
    curr_time = datetime.utcnow().isoformat() + "Z"  # 'Z' indicates UTC+0
    change_input = {
        "project": "aosp/platform/packages/modules/Bluetooth",
        "branch": "main",
        "subject": f"merge from upstream/main into main at {curr_time}",
        "merge": {
            "source": "upstream/main",
            "source_branch": "upstream/main",
            "strategy": "recursive",
            "allow_conflicts": True,
        },
    }
    cl_number = gerrit("changes/", method="POST", data=change_input)["_number"]
    logging.info("Created merge CL: https://crrev.com/c/%s", cl_number)
    create_overlay_cl_from_merge(cl_number)


def main():
    parser = argparse.ArgumentParser(
        description="Manipulate the Floss upstream/local patches"
    )
    parser.add_argument(
        "--log_level",
        choices=["debug", "info", "quiet"],
        default="info",
        help="Loging level. Default to 'info'",
    )
    parser.add_argument(
        "command",
        choices=["pull"],
        help=(
            "'pull' pulls the upstream patches to local, which should be done "
            "every time a merge is created. By default it works independently "
            "and doesn't rely on any local data. It creates a merge in the "
            ".../Bluetooth/local repo, pulls all upstream patches to local in "
            "chromiumos-overlay repo, set 2 CLs to Cq-Depend, and vote CQ+1. "
        ),
    )
    parser.add_argument(
        "--from_merge",
        type=int,
        metavar="CL_NUMBER",
        help=(
            "Only available in 'pull' command. Don't create a merge, instead, "
            "update patches based on the given merge CL and upload a overlay "
            "CL. It still sets both to the dependencies and vote CQ+1."
        ),
    )

    args = parser.parse_args()

    if args.log_level != "quiet":
        level = logging.DEBUG if args.log_level == "debug" else logging.INFO
        logging.basicConfig(
            format="%(asctime)s floss_patches: %(levelname)s: %(message)s",
            level=level,
        )

    if args.command == "pull":
        response = input(
            "CAUTION: You are attempting to create an overlay CL "
            "and maybe even a Floss merge CL, continue? [N/y] "
        )
        if len(response) == 0 or response[0] not in "Yy":
            logging.info("Exiting")
            return
        if args.from_merge is not None:
            create_overlay_cl_from_merge(args.from_merge)
        else:
            create_merge()
    else:
        raise ValueError(f"Invalid command: {args.command}")


if __name__ == "__main__":
    main()
