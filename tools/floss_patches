class GitHelper(object):
    """Git helper class that runs git commands on a specific path."""

    def __init__(self, path):
        self.path = path
        self.git_command = ["git", "-C", str(self.path)]

    def clone(self, repo_url, branch=None, depth=None):
        """Clones a remote repo to local.

        Args:
            repo_url: The remote repo URL str.
            branch: The target branch name. If None, clones all branches.
            depth: The history depth. If None, clones the full history.
        """
        cmd = ["git", "clone"]
        if branch is not None:
            cmd.append("--branch")
            cmd.append(branch)
        if depth is not None:
            cmd.append("--depth")
            cmd.append(str(depth))
        cmd.append(repo_url)
        cmd.append(str(self.path))
        subprocess.check_call(cmd)

    def add(self):
        """Adds all changes into index."""
        subprocess.check_call(self.git_command + ["add", "."])

    def checkout(self, hash):
        subprocess.check_call(self.git_command + ["checkout", "--quiet", hash])

    def am(self, patches):
        subprocess.check_call(self.git_command + ["am"] + patches)

    def rebase(self, hash):
        subprocess.check_call(self.git_command + ["rebase", hash])

    def diff(self, stat=None):
        """Returns the diff of the cached (staged) changes.

        Args:
            stat: The diff stat format.
        """
        cmd = ["diff", "--cached"]
        if stat is not None:
            cmd.append(f"--stat={stat}")
        return subprocess.check_output(self.git_command + cmd)

    def format_patch(self, range, out_dir=None, unified=None, signature=None):
        """Generates patches.

        Args:
            range: The git revision range str. For example HASH1..HASH2
                   generates patches for each commit between HASH1 and HASH2,
                   while HASH1 is not included but HASH2 is.
                   Alternatively, use -<n> to generate patches from the topmost
                   <n> commits.
            out_dir: The output directory path str.
            unified: An int indicating the lines before and after the changed
                     lines.
            signature: The signature str at the end of the patch file.
        """
        cmd = ["format-patch", range]
        if out_dir is not None:
            cmd.append("--output-directory")
            cmd.append(out_dir)
        if unified is not None:
            cmd.append(f"--unified={unified}")
        if signature is None:
            cmd.append("--no-signature")
        else:
            cmd.append(f"--signature={signature}")
        subprocess.check_call(self.git_command + cmd)

    def get_head_commit(self):
        return (
            subprocess.check_output(
                self.git_command + ["log", "-1", "--format=format:%H"]
            )
            .decode("utf-8")
            .strip()
        )

    def is_clean(self):
        return (
            subprocess.check_output(
                self.git_command + ["status", "--porcelain"]
            )
            == b""
        )

    def check_is_ancestor(self, lhs, rhs):
        subprocess.check_call(
            self.git_command + ["merge-base", lhs, "--is-ancestor", rhs]
        )


class OverlayHelper(object):
    """Helper for modifying the given chromiumos-overlay repo."""

    GIT_AM_HINT_PREFIX = "DEV_PATCHES=(  # git am hint: "
    REL_PATCHES_START_LINE = "REL_PATCHES=(\n"
    REL_PATCHES_END_LINE = ")  # REL_PATCHES end\n"

    def __init__(self, path):
        self.overlay_path = path
        self.floss_overlay_path = self.overlay_path / "net-wireless" / "floss"
        if not self.floss_overlay_path.is_dir():
            raise ValueError("Failed to anchor Floss overlay directory path")
        self.ebuild_path = self.floss_overlay_path / "floss-9999.ebuild"
        if not self.ebuild_path.is_file():
            raise ValueError("Failed to anchor Floss ebuild path")

    def floss_pull_upstream_patches(self):
        """Pulls all upstream patch files to local.

        All local patch files will be removed and the REL_PATCHES list in
        floss-9999.ebuild will be updated.
        """
        local_patches_path = self.floss_overlay_path / "files" / "patches"
        if local_patches_path.exists():
            if not local_patches_path.is_dir():
                raise ValueError(f"{local_patches_path} is not a dir")
            shutil.rmtree(str(local_patches_path))

        upstream_patches_path = (
            self.floss_overlay_path / "files" / "patches_upstream"
        )
        if upstream_patches_path.exists():
            if not upstream_patches_path.is_dir():
                raise ValueError(f"{upstream_patches_path} is not a dir")
            logging.debug(
                "Copying upstream patches from %s to %s",
                upstream_patches_path,
                local_patches_path,
            )
            shutil.copytree(str(upstream_patches_path), str(local_patches_path))

        with open(str(self.ebuild_path), "r") as filehandle:
            floss_ebuild_lines = filehandle.readlines()

        rel_patches_start_line = None
        rel_patches_end_line = None
        logging.debug("Current REL_PATCHES:")
        for i, line in enumerate(floss_ebuild_lines):
            if line == self.REL_PATCHES_END_LINE:
                rel_patches_end_line = i
                break
            if rel_patches_start_line is not None:
                logging.debug(" %s", line.strip())
            if line == self.REL_PATCHES_START_LINE:
                rel_patches_start_line = i + 1
        if rel_patches_start_line is None or rel_patches_end_line is None:
            raise RuntimeError("Failed to anchor REL_PATCHES list")

        logging.debug("New REL_PATCHES:")
        local_patch_lines = []
        if local_patches_path.exists():
            for patches in sorted(local_patches_path.iterdir()):
                local_patch_lines.append(
                    '\t"${FILESDIR}"/patches/' + patches.name + "\n"
                )
                logging.debug(" %s", local_patch_lines[-1].strip())
        logging.debug(
            "Update %s's REL_PATCHES with current local patches",
            self.ebuild_path,
        )
        with open(str(self.ebuild_path), "w") as filehandle:
            filehandle.writelines(floss_ebuild_lines[:rel_patches_start_line])
            filehandle.writelines(local_patch_lines)
            filehandle.writelines(floss_ebuild_lines[rel_patches_end_line:])

    def floss_update_git_am_hint(self, hint):
        """Updates the git am hint in floss-9999.ebuild.

        The hint indicates the "known good commit" that the upstream patches
        can be applied on without conflicts. There are 2 common timing to
        update it:
            * Some upstream conflicts are fixed
            * A new merge from upstream to local just landed (local and
              upstream tree should be exactly the same on the point of merge,
              if the merge passed CQ then it must be a good commit)

        Args:
            hint: The 40-letters SHA-1 hash.
        """
        if len(hint) != 40 or any(c not in string.hexdigits for c in hint):
            raise ValueError(
                "Invalid git am hint, expect a 40-digits commit hash"
            )

        with open(str(self.ebuild_path), "r") as filehandle:
            floss_build_lines = filehandle.readlines()
        for i in range(len(floss_build_lines)):
            if floss_build_lines[i].startswith(self.GIT_AM_HINT_PREFIX):
                logging.debug(
                    "Changing git am hint from %s to %s",
                    floss_build_lines[i][len(self.GIT_AM_HINT_PREFIX) : -1],
                    hint,
                )
                floss_build_lines[i] = f"{self.GIT_AM_HINT_PREFIX}{hint}\n"
                break
        else:
            raise RuntimeError("Git am hint not found in ebuild")
        logging.debug(
            "Update %s's `git am hint` with the specified hint",
            self.ebuild_path,
        )
        with open(str(self.ebuild_path), "w") as filehandle:
            filehandle.writelines(floss_build_lines)

    def floss_get_git_am_hint(self):
        with open(str(self.ebuild_path), "r") as filehandle:
            for line in filehandle:
                if line.startswith(self.GIT_AM_HINT_PREFIX):
                    return line[len(self.GIT_AM_HINT_PREFIX) : -1]
        raise RuntimeError("Git am hint not found in ebuild")


def gerrit(api_name, method=None, data=None):
    """Sends requests to CrOS external Gerrit instance.

    Args:
        api_name: The Gerrit API name as part of Gerrit request URL.
        method: HTTP method e.g. 'GET', 'POST'.
        data: The HTTP body. It is always converted to JSON.

    Returns:
        The parsed JSON response if any; Otherwise None.
    """

    def get_git_cookies(path):
        """Returns the user's gitcookies matching the path."""
        cookies = {}
        with open(str(Path.home() / ".gitcookies"), "r") as filehandle:
            for line in filehandle:
                fields = line.strip().split("\t")
                if line.strip().startswith("#") or len(fields) != 7:
                    continue
                domain, xpath, key, value = (
                    fields[0],
                    fields[2],
                    fields[5],
                    fields[6],
                )
                if (
                    domain == "chromium-review.googlesource.com"
                    and path.startswith(xpath)
                ):
                    cookies[key] = value
        if not cookies:
            raise RuntimeError("Valid git cookie not found")
        return "; ".join(f"{k}={v}" for k, v in cookies.items())

    url = f"https://chromium-review.googlesource.com/a/{api_name}"
    headers = {"Cookie": get_git_cookies(f"/a/{api_name}")}
    if data is not None:
        data = json.dumps(data).encode("utf-8")
        headers["Content-Type"] = "application/json; charset=utf-8"
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    logging.debug("Calling Gerrit API: URL=%s, method=%s", url, method)
    with urllib.request.urlopen(req) as handle:
        response = handle.read()

    if not response:
        return None

    response = response.decode("utf-8")
    MAGIC_PREFIX = ")]}'"
    if not response.startswith(MAGIC_PREFIX):
        raise RuntimeError("Unexpected Gerrit API response format")
    response = response[len(MAGIC_PREFIX) :]
    return json.loads(response)


def create_overlay_cl_from_merge(bt_cl):
    """Creates an overlay CL from a given BT merge CL.

    Args:
        bt_cl: The reference BT merge CL's ChangeInfo entity defined in the
               Gerrit REST API
    """

    # The first hash in the merge list; Used for git am hint
    hash = gerrit(
        f"changes/{bt_cl['id']}/revisions/current/mergelist", method="GET"
    )[0]["commit"]

    # Generate the overlay diff in a temporary directory.
    with tempfile.TemporaryDirectory() as temp_dir:
        temp_dir = Path(temp_dir)
        git_helper = GitHelper(temp_dir)
        logging.info("Cloning chromiumos-overlay...")
        # Cloning with depth=1 because the history is really heavy (~2GB).
        git_helper.clone(
            "https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay",
            branch="main",
            depth=1,
        )

        overlay_helper = OverlayHelper(temp_dir)
        overlay_helper.floss_pull_upstream_patches()
        overlay_helper.floss_update_git_am_hint(hash)

        git_helper.add()
        logging.debug(
            "Overlay diff stat:\n%s",
            # The default stat width (80) is usually not enough for displaying
            # the patch files.
            git_helper.diff(stat=200).decode("utf-8")[:-1],
        )
        diff = git_helper.diff()

    # Create the CL for updating patch files
    curr_time = datetime.now(tz=timezone.utc).isoformat(timespec="seconds")
    overlay_cl_message = textwrap.dedent(
        f"""\
        floss: Pull upstream patches to local at {curr_time}

        BUG=None
        TEST=CQ

        Cq-Depend: chromium:{bt_cl["_number"]}
        """
    )
    change_input = {
        "project": "chromiumos/overlays/chromiumos-overlay",
        "branch": "main",
        "subject": overlay_cl_message,
        "patch": {"patch": base64.b64encode(diff).decode("utf-8")},
    }
    logging.info("Creating overlay CL...")
    overlay_cl = gerrit("changes/", method="POST", data=change_input)
    logging.info(
        "Created overlay CL: https://crrev.com/c/%s", overlay_cl["_number"]
    )
    return overlay_cl


def set_depend_and_vote(bt_cl, overlay_cl, proto_cl):
    """Sets up the dependency of the BT merge CL and vote CQ+1 for each.

    The overlay CL and the BT merge CL are Cq-Depend each other.
    The BT merge CL also Cq-Depend on the proto_logging CL.

    Args:
        bt_cl: The reference BT merge CL's ChangeInfo entity defined in the
               Gerrit REST API
        overlay_cl: The reference overlay CL's ChangeInfo entity defined in the
                    Gerrit REST API
        proto_cl: The reference proto_logging merge CL's ChangeInfo entity
                  defined in the Gerrit REST API; None if the proto_logging
                  repo has no new commits.
    """
    logging.info("Setting Cq-Depend for the BT merge CL...")

    bt_cl_msg = gerrit(
        f"changes/{bt_cl['id']}/revisions/current/commit", method="GET"
    )["message"]
    bt_cl_msg = bt_cl_msg.splitlines(True)
    for i in range(len(bt_cl_msg)):
        if bt_cl_msg[i].startswith("Change-Id: "):
            # Intentionally put Cq-Depend after Change-Id to follow the message
            # format generated by |create_overlay_cl_from_merge|.
            cq_depend_block = [f'Cq-Depend: chromium:{overlay_cl["_number"]}\n']
            if proto_cl:
                cq_depend_block.append(
                    f'Cq-Depend: chromium:{proto_cl["_number"]}\n'
                )
            bt_cl_msg = (
                bt_cl_msg[: i + 1] + cq_depend_block + bt_cl_msg[i + 1 :]
            )
            break
    else:
        raise RuntimeError("Change-Id not found in the merge CL")
    gerrit(
        f"changes/{bt_cl['id']}/message",
        method="PUT",
        data={"message": "".join(bt_cl_msg)},
    )

    logging.info("Updated Cq-Depend of the BT merge CL; Voting CQ+1...")

    gerrit(
        f"changes/{bt_cl['id']}/revisions/current/review",
        method="POST",
        data={"labels": {"Commit-Queue": 1}},
    )
    gerrit(
        f'changes/{overlay_cl["id"]}/revisions/current/review',
        method="POST",
        data={"labels": {"Commit-Queue": 1}},
    )
    if proto_cl is not None:
        gerrit(
            f"changes/{proto_cl['id']}/revisions/current/review",
            method="POST",
            data={"labels": {"Commit-Queue": 1}},
        )
    logging.info("Set CQ dry run successfully")


def create_merge(project, dest_branch, source_branch):
    """Creates a merge CL through Gerrit REST API.

    Args:
        project: The project name on the Gerrit instance.
        dest_branch: The destination branch to merge into.
        source_branch: The source branch to merge from.

    Returns:
        The ChangeInfo entity defined in the Gerrit REST API; If there are no
        new commits since the last merge, returns None.
    """
    logging.info("Creating merge for %s...", project)
    curr_time = datetime.now(tz=timezone.utc).isoformat(timespec="seconds")
    change_input = {
        "project": project,
        "branch": dest_branch,
        "subject": (
            f"Merge from {source_branch} into {dest_branch} at {curr_time}"
        ),
        "merge": {
            "source": source_branch,
            "source_branch": source_branch,
            "strategy": "recursive",
            "allow_conflicts": True,
        },
    }
    try:
        cl = gerrit("changes/", method="POST", data=change_input)
    except urllib.error.HTTPError as e:
        if e.code != 409:
            raise
        body = e.fp.read()
        if body is None or not body.strip().decode("utf-8").endswith(
            " has already been merged"
        ):
            raise
        logging.info("No commits since the last merge")
        return None

    logging.info("Created merge CL: https://crrev.com/c/%s", cl["_number"])
    return cl


def pull():
    """Creates an overlay CL, a BT merge CL, and a proto_logging merge CL.

    Implementation of `floss_patches pull`.
    """
    bt_cl = create_merge(
        "aosp/platform/packages/modules/Bluetooth", "main", "upstream/main"
    )
    if bt_cl is None:
        logging.info(
            "Returns early as no new Floss commits since the last merge"
        )
        return
    overlay_cl = create_overlay_cl_from_merge(bt_cl)
    proto_cl = create_merge(
        "aosp/platform/frameworks/proto_logging",
        "master",  # nocheck
        "upstream/main",
    )
    set_depend_and_vote(bt_cl, overlay_cl, proto_cl)


def get_local_floss_and_overlay_path():
    cros_root = Path(__file__).resolve().parent
    for _ in range(4):
        cros_root = cros_root.parent
    floss_path = (
        cros_root
        / "src"
        / "aosp"
        / "packages"
        / "modules"
        / "Bluetooth"
        / "upstream"
    )
    overlay_path = cros_root / "src" / "third_party" / "chromiumos-overlay"
    if not floss_path.is_dir():
        raise RuntimeError("Failed to anchor Floss upstream path in CrOS SDK")
    if not overlay_path.is_dir():
        raise RuntimeError("Failed to anchor chromiumos-overlay in CrOS SDK")
    return floss_path, overlay_path


def fix_upstream_patches():
    """Fix the upstream patches.

    Implementation of `floss_patches fix_upstream`.
    """
    floss_path, overlay_path = get_local_floss_and_overlay_path()
    overlay_helper = OverlayHelper(overlay_path)
    patches_path = (
        overlay_helper.floss_overlay_path / "files" / "patches_upstream"
    )

    if not patches_path.exists():
        logging.info("Patches directory doesn't exist; Nothing to be done")
        return
    if not patches_path.is_dir():
        raise ValueError(str(patches_path) + " is not a dir")

    logging.info("Fixing upstream patches, floss repo = %s", floss_path)

    hint = overlay_helper.floss_get_git_am_hint()
    logging.info("Current git am hint: %s", hint)

    git_helper = GitHelper(floss_path)
    if not git_helper.is_clean():
        raise RuntimeError("Floss upstream repo is not clean")
    git_helper.check_is_ancestor(hint, "m/main")

    # Am and rebase
    git_helper.checkout(hint)
    git_helper.am([str(p) for p in sorted(patches_path.iterdir())])
    try:
        git_helper.rebase("m/main")
    except subprocess.CalledProcessError:
        logging.warning(
            "!!! Please follow the instructions above to resolve the "
            "conflicts, then re-run the script with `--continue` !!!"
        )
        return

    logging.error(
        "Rebased successfully, which means no conflicts! "
        "Leaving the am-ed tree as is and exit."
    )


def fix_upstream_patches_continue():
    """Fix the upstream patches.

    Implementation of `floss_patches fix_upstream`.
    """
    floss_path, overlay_path = get_local_floss_and_overlay_path()
    overlay_helper = OverlayHelper(overlay_path)
    patches_path = (
        overlay_helper.floss_overlay_path / "files" / "patches_upstream"
    )

    git_helper = GitHelper(floss_path)
    if not git_helper.is_clean():
        raise RuntimeError("Floss upstream repo is not clean")
    if overlay_path.joinpath(".git", "rebase-merge").exists():
        raise RuntimeError(
            "Found .git/rebase-merge in overlay, rebase unfinished?"
        )

    logging.info(
        "Fixing (--continue) upstream patches, floss repo = %s", floss_path
    )

    # Remove old patches first
    if patches_path.exists():
        if not patches_path.is_dir():
            raise ValueError(str(patches_path) + "is not a dir")
        shutil.rmtree(str(patches_path))

    # Generate patches
    logging.info("Generating patch files...")
    rebased_head = git_helper.get_head_commit()
    git_helper.format_patch(
        f"m/main..{rebased_head}",
        out_dir=str(patches_path),
        unified=1,
        signature=None,
    )

    # Update hint
    git_helper.checkout("m/main")
    new_hint = git_helper.get_head_commit()
    overlay_helper.floss_update_git_am_hint(new_hint)

    logging.info(
        "Fix patches done. "
        "Test it with `USE=floss_upstream emerge-${BOARD} floss`, "
        "and upload the changes in %s for review.",
        overlay_path,
    )


def main():
    parser = argparse.ArgumentParser(
        description="Manipulate the Floss upstream/local patches"
    )
    parser.add_argument(
        "--log_level",
        choices=["debug", "info", "quiet"],
        default="info",
        help="Loging level. Default to 'info'",
    )
    parser.add_argument(
        "command",
        choices=["pull", "fix_upstream"],
        help=(
            "'pull' pulls the upstream patches to local, which should be done "
            "every time a merge is created. By default it works independently "
            "and doesn't rely on any local data. It creates a merge in the "
            ".../Bluetooth/local repo and the proto_logging repo, pulls all "
            "upstream patches to local in chromiumos-overlay repo, properly "
            "set Cq-Depend, and vote CQ+1 for each. "
            "'fix_upstream' helps rebase the upstream patches to ToT. The "
            "developer should resolve the conflicts in the "
            ".../Bluetooth/upstream repo on the local storage, and re-run "
            "this script with the '--continue' flag."
        ),
    )
    parser.add_argument(
        "--continue",
        action="store_true",
        help=(
            "The 'fix_upstream' command stops when there are any conflicts "
            "that require deveplopers to resolve. Re-run the script with this "
            "flag to continue the progress."
        ),
        dest="continue_fix",
    )

    args = parser.parse_args()

    if args.log_level != "quiet":
        level = logging.DEBUG if args.log_level == "debug" else logging.INFO
        logging.basicConfig(
            format="%(asctime)s floss_patches: %(levelname)s: %(message)s",
            level=level,
        )

    if args.command == "pull":
        response = input(
            "CAUTION: You are attempting to create an overlay CL "
            "and maybe even a Floss merge CL, continue? [N/y] "
        )
        if len(response) == 0 or response[0] not in "Yy":
            logging.info("Exiting")
            return
        pull()
    elif args.command == "fix_upstream":
        if args.continue_fix:
            fix_upstream_patches_continue()
        else:
            fix_upstream_patches()
    else:
        raise ValueError(f"Invalid command: {args.command}")


if __name__ == "__main__":
    main()
