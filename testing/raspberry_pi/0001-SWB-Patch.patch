+static uint32_t preprocess_and_decode_lc3_data(void *userdata, uint8_t *read_data, int size_read)
+{
+	struct impl *this = userdata;
+	struct port *port = &this->port;
+	uint32_t decoded = 0;
+	int i;
+
+	spa_log_trace(this->log, "handling LC3 data");
+
+	/*
+	 * Check if the packet contains only zeros - if so ignore the packet.
+	 * This is necessary, because some kernels insert bogus "all-zero" packets
+	 * into the datastream.
+	 * See https://gitlab.freedesktop.org/pipewire/pipewire/-/issues/549
+	 */
+	if (is_zero_packet(read_data, size_read))
+		return 0;
+
+	for (i = 0; i < size_read; ++i) {
+		void *buf;
+		uint32_t avail;
+		int seq, rc;
+
+		lc3_buffer_append_byte(this, read_data[i]);
+
+		if (this->buffer_pos != SWB_ENCODED_SIZE)
+			continue;
+
+		/*
+		 * Handle found LC3 packet
+		 */
+
+		buf = spa_bt_decode_buffer_get_write(&port->buffer, &avail);
+
+		/* Check sequence number */
+		seq = ((this->buffer[1] >> 4) & 1) |
+			((this->buffer[1] >> 6) & 2);
+
+    bool force_plc = false;
+		spa_log_trace(this->log, "LC3 packet seq=%u", seq);
+		if (!this->seq_initialized) {
+			this->seq_initialized = true;
+			this->seq_num = seq;
+		} else if (seq != this->seq_num) {
+      force_plc = true;
+			spa_log_info(this->log,
+					"missing LC3 packet: %u != %u", seq, this->seq_num);
+			this->seq_num = seq;
+		}
+
+		this->seq_num = (this->seq_num + 1) % 4;
+
+		if (avail < SWB_DECODED_SIZE)
+			spa_log_warn(this->log, "Output buffer full, dropping lc3 data");
+
+		if (force_plc) {
+			rc = lc3_decode(this->lc3, NULL, 0, LC3_PCM_FORMAT_S16, buf, 1);
+		} else {
+			/* decode frame */
+			rc = lc3_decode(this->lc3, this->buffer + 2, SWB_ENCODED_SIZE - 2,
+					LC3_PCM_FORMAT_S16, buf, 1);
+		}
+
+		if (rc == 1) {
+			spa_log_debug(this->log, "lc3_decode conducted a PLC");
+		}
+
+		if (rc < 0) {
+			spa_log_warn(this->log, "lc3_decode failed: %d", rc);
+			continue;
+		}
+
+		spa_bt_decode_buffer_write_packet(&port->buffer, SWB_DECODED_SIZE);
+		decoded += SWB_DECODED_SIZE;
+	}
+
+	return decoded;
+}
