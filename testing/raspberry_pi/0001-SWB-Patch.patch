+// Note that SWB is supported iff mSBC over transparent air mode is supported.
+static bool is_hfp_swb_enabled(struct impl *backend)
+{
+	uint32_t bt_features;
+
+	if (backend->quirks && spa_bt_quirks_get_features(backend->quirks, NULL, NULL, &bt_features) == 0)
+		return bt_features & SPA_BT_FEATURE_HFP_SWB;
+
+	return true;
+}
