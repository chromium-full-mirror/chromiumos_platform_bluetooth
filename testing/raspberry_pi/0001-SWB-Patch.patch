+static void lc3_buffer_append_byte(struct impl *this, uint8_t byte)
+{
+        /* Parse LC3 frame header */
+        if (this->buffer_pos == 0) {
+                if (byte != 0x01) {
+                        this->buffer_pos = 0;
+                        return;
+                }
+        }
+        else if (this->buffer_pos == 1) {
+                if (!((byte & 0x0F) == 0x08 &&
+                      ((byte >> 4) & 1) == ((byte >> 5) & 1) &&
+                      ((byte >> 6) & 1) == ((byte >> 7) & 1))) {
+                        this->buffer_pos = 0;
+                        return;
+                }
+        }
+        else if (this->buffer_pos >= SWB_ENCODED_SIZE) {
+                /* Packet completed. Reset. */
+                this->buffer_pos = 0;
+                lc3_buffer_append_byte(this, byte);
+                return;
+        }
+        this->buffer[this->buffer_pos] = byte;
+        ++this->buffer_pos;
 }
 
